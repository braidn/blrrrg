<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>{{ metadata.title }}</title>

    <meta name="description" content="{{metadata.site.description}}">
    <meta name="robots" content="index,follow">
    <meta name="generator" content="Eleventy">

    <!--Twitter Card-->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@{{metadata.site.twitter}}">
    <meta name="twitter:creator" content="@{{metadata.author.twitter}}">
    <meta name="twitter:url" content="{{metadata.site.baseURL}}">
    <meta name="twitter:title" content="{{metadata.title}}">
    <meta name="twitter:description" content="{{ metadata.site.description }}">
    
    <!--Schema-->
    <link rel="author" href="{{metadata.author.twitter}}">
    <link rel="publisher" href="{{metadata.site.baseURL}}">
    <meta itemprop="name" content="{{metadata.title}}">
    <meta itemprop="description" content="{{ metadata.site.description }}">
    
    <!-- Facebook OpenGraph -->
    <meta property="fb:app_id" content="{{metadata.site.fb_app_id}}">
    <meta property="og:url" content="{{metadata.site.baseURL}}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{metadata.title}}">
    <meta property="og:description" content="{{ metadata.site.description }}">
    <meta property="og:site_name" content="{{metadata.title}}">
    <meta property="og:locale" content="en_US">
    <meta property="article:author" content="{{site.author.twitter}}">

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..600&display=swap"
      rel="stylesheet"
    />
    <link rel="webmention" href="https://webmention.io/cloudbacon.com/webmention" />
    <link rel="pingback" href="https://webmention.io/cloudbacon.com/xmlrpc" />
    <link rel="icon" href="/img/bacon-svgrepo-com.svg" type="image/svg+xml">
		{% css %}{% include "styles/common.css" %}{% endcss %}
		{% css %}{% include "styles/homepage.css" %}{% endcss %}
		{% css %}{% include "styles/blogpost.css" %}{% endcss %}
		{% css %}{% include "styles/prism-ally-dark.css" %}{% endcss %}
		{% if eleventy.env.runMode == "serve" %}
      <link rel="stylesheet" href="{% getBundleFileUrl "css" %}">
		{% else  %}
      <style>{% getBundle "css" %}</style>
		{% endif %}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <div class="container">
      <header class="site-header">
        <div class="brand">
          <a href="/" class="brand-link">
            <span class="brand-icon">
              <img src="/img/bacon-svgrepo-com.svg" alt="" width="22" height="22" aria-hidden="true" />
            </span>
            <span class="brand-name">Cloudbacon</span>
          </a>
          <span class="brand-badge mono">est. 2011</span>
        </div>
        <nav class="site-nav mono" aria-label="Main navigation">
          <a href="/feed.xml" aria-label="RSS Feed">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
            RSS
          </a>
          <a href="{{metadata.author.github}}" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="{{metadata.author.identity}}" target="_blank" rel="me noopener noreferrer">Mastodon</a>
        </nav>
      </header>

      <section class="hero-section">
        <h1 class="hero-title">Musings of a journeyman programmer.</h1>
        <p class="hero-bio">
          Hi! My name is <strong>{{metadata.author.name}}</strong> (or 
          "<a href="{{metadata.author.identity}}" rel="me">braidn</a>" throughout the Internet).
          I am currently {{metadata.author.gig.title}}
          @ <a href="{{metadata.author.gig.url}}">{{metadata.author.gig.name}}</a>.
        </p>
      </section>

      <main id="main" tabindex="-1">
        {{ content }}
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-credits mono">
            © {{ "now" | date: "%Y" }} {{ metadata.author.name }} • Transposed to octal
          </p>
          <div class="footer-links mono">
            <a href="/feed.xml">Feed</a>
            <a href="{{ metadata.author.identity }}" rel="me">Mastodon</a>
            <a href="{{ metadata.author.github }}">GitHub</a>
            <a href="{{ metadata.author.gig.url }}">LinkedIn</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
